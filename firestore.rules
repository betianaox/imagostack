rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// REGLAS DE SEGURIDAD DE FIRESTORE
// ─────────────────────────────────────────────────────────────────────────────
// Como el navegador escribe directo en Firestore, estas reglas son la única
// barrera real: no hay servidor propio validando en el medio. Un error acá no
// es un bug, es una filtración.
//
// El modelo es el mismo que va a usarse en cualquier proyecto:
//
//   users/{uid}        rol de cada persona (visitor | operator | admin)
//   conversations/{id}    hilo de chat, con su dueño y su modo
//     messages/{id}       mensajes, inmutables una vez escritos
//
// Lo que cambia entre un sitio y otro es quién tiene cada rol, no las reglas.
//
// Se despliegan con:  firebase deploy --only firestore:rules
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Salvavidas: este correo siempre puede operar, aunque la coleccion de
    // usuarios este vacia o alguien se equivoque asignando roles. Sin esto,
    // un error de datos deja el panel inaccesible para siempre.
    function isBootstrapAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['imagostack8@gmail.com'];
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // El get() solo se evalua si hace falta: el bootstrap corta antes.
    function roleIs(role) {
      return hasProfile() && userDoc().data.role == role;
    }

    function isAdmin() {
      return isBootstrapAdmin() || roleIs('admin');
    }

    // Quien puede atender conversaciones desde el panel.
    function isOperator() {
      return isAdmin() || roleIs('operator');
    }

    function isOwner(data) {
      return signedIn() && data.ownerId == request.auth.uid;
    }

    // ── Usuarios ────────────────────────────────────────────────────────────
    // El perfil se crea al iniciar sesión. Los visitantes anónimos no tienen
    // documento acá: viven solo en su conversación, para no llenar la
    // colección de registros de gente que no vuelve.
    match /users/{uid} {

      function validLang(data) {
        return data.lang in ['es', 'en', 'pt'];
      }

      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);

      // Al crear su perfil nadie puede auto-asignarse un rol distinto de
      // visitante: promover es potestad de un administrador.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'visitor'
        && validLang(request.resource.data);

      // El dueño puede editar sus datos —incluido el idioma— pero nunca su rol.
      allow update: if validLang(request.resource.data)
        && (isAdmin()
            || (signedIn()
                && request.auth.uid == uid
                && request.resource.data.role == resource.data.role));

      allow delete: if isAdmin();
    }

    // ── Conversaciones ──────────────────────────────────────────────────────
    match /conversations/{conversationId} {

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.mode == 'bot';

      allow read: if isOperator() || isOwner(resource.data);

      // El dueño puede actualizar su conversación pero NO cambiar el modo ni
      // el dueño: tomar una conversación es potestad del operador.
      allow update: if isOperator()
        || (isOwner(resource.data)
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.mode == resource.data.mode);

      allow delete: if isAdmin();

      match /messages/{messageId} {

        // `ownerId` se repite en cada mensaje a propósito: leer la
        // conversación padre con get() costaría una lectura extra por cada
        // mensaje evaluado, y esto se lee en tiempo real.
        allow read: if isOperator() || isOwner(resource.data);

        allow create: if isOperator()
          || (isOwner(request.resource.data)
              && request.resource.data.role in ['user', 'assistant']
              && request.resource.data.text is string
              && request.resource.data.text.size() <= 5000);

        // Un mensaje escrito no se toca. Sin excepciones.
        allow update, delete: if false;
      }
    }

    // Todo lo que no esté contemplado arriba queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
